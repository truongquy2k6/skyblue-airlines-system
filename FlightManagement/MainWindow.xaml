<Window x:Class="FlightManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SkyBlue Airlines - Hệ thống Quản lý" Height="800" Width="1400" 
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen" WindowState="Normal"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Closing="Window_Closing"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    
    <Window.Resources>
        <Style x:Key="SidebarBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="icon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                    VerticalAlignment="Center" Width="20" Height="20" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F4FF"/>
                                <Setter Property="Foreground" Value="#3949AB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3949AB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style cho tiêu đề nhóm chức năng ở menu trái -->
        <Style x:Key="SidebarGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4AE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="24,16,16,8"/>
        </Style>
        
        <!-- Window Control Button Style (giống LUnivers Beaute) -->
        <Style x:Key="WinControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Outer Border -->
    <Border x:Name="mainBorder" CornerRadius="16" BorderThickness="0">
        <Border.Background>
            <ImageBrush ImageSource="/Image/MainBackground.jpg" Stretch="UniformToFill"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FLOATING SIDEBAR -->
            <Border Grid.Column="0" CornerRadius="16" Margin="16,16,8,16" Background="#E8FFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.06" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Logo -->
                    <StackPanel Margin="20,24,20,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0" Background="White" Padding="3">
                                <Image Source="/LogoFlightManagement.ico" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SkyBlue" FontSize="18" FontWeight="Black" Foreground="#2D2D2D"/>
                                <TextBlock Text="Airlines" FontSize="12" Foreground="#3949AB" FontStyle="Italic" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#F0F0F0" Margin="0,20,0,0"/>
                    </StackPanel>
                    
                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,15">
                            <TextBlock x:Name="headerTongQuan" Text="TỔNG QUAN" Style="{StaticResource SidebarGroupHeader}" Margin="24,8,16,8"/>
                            <RadioButton x:Name="btnTrangChu" Content="Trang chủ" Style="{StaticResource SidebarBtn}" GroupName="nav" IsChecked="True" Click="Nav_Click" Tag="HomeOutline" Uid="TrangChu"/>
                            <RadioButton x:Name="btnBaoCao" Content="Báo cáo &amp; Thống kê" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="ChartBar" Uid="BaoCao"/>
                            
                            <TextBlock x:Name="headerVeDichVu" Text="VÉ &amp; DỊCH VỤ" Style="{StaticResource SidebarGroupHeader}"/>
                            <RadioButton x:Name="btnTimKiem" Content="Tìm kiếm Chuyến bay" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="AirplanSearch" Uid="TimKiem"/>
                            <RadioButton x:Name="btnDatVe" Content="Đặt vé Máy bay" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="TicketConfirmation" Uid="DatVe" Visibility="Collapsed"/>
                            <RadioButton x:Name="btnQuanLyVe" Content="Vé &amp; Đặt chỗ" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="TicketOutline" Uid="QuanLyVe"/>
                            <RadioButton x:Name="btnDichVu" Content="Quản lý Dịch vụ" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="RoomServiceOutline" Uid="DichVu"/>
                            <RadioButton x:Name="btnCSKH" Content="Chăm sóc Khách hàng" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="Headset" Uid="CSKH"/>

                            <TextBlock x:Name="headerDieuHanhBay" Text="ĐIỀU HÀNH BAY" Style="{StaticResource SidebarGroupHeader}"/>
                            <RadioButton x:Name="btnLichBay" Content="Quản lý Lịch bay" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="CalendarClock" Uid="LichBay"/>
                            <RadioButton x:Name="btnTuyenBay" Content="Tuyến bay &amp; Đội bay" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="MapMarkerPath" Uid="TuyenBay"/>
                            <RadioButton x:Name="btnHangGhe" Content="Cấu hình Hạng ghế" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="SeatOutline" Uid="HangGhe"/>

                            <TextBlock x:Name="headerHeThong" Text="HỆ THỐNG" Style="{StaticResource SidebarGroupHeader}"/>
                            <RadioButton x:Name="btnNhanVien" Content="Quản lý Nhân viên" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="AccountGroup" Uid="NhanVien"/>
                            <RadioButton x:Name="btnLichSu" Content="Lịch sử Hệ thống" Style="{StaticResource SidebarBtn}" GroupName="nav" Click="Nav_Click" Tag="History" Uid="LichSu"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Bottom Actions -->
                    <StackPanel Grid.Row="2" Margin="10,0,10,12">
                        <Border Height="1" Background="#F0F0F0" Margin="6,0,6,8"/>
                        <Grid Margin="4,0,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,4,10,8">
                                <TextBlock x:Name="txtUserName" Text="Nguyễn Quản Trị" FontWeight="SemiBold" Foreground="#2D2D2D" FontSize="13"/>
                                <TextBlock x:Name="txtUserEmail" Text="admin@skyblue.vn" Foreground="#90A4AE" FontSize="11" Margin="0,2,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="roleBadge" CornerRadius="4" Padding="6,2" Background="#3949AB" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtRoleBadge" Text="Administrator" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="#F0F2F5">
                                        <TextBlock x:Name="txtOfficeBadge" Text="Văn phòng Hà Nội" Foreground="#546E7A" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Row="1" Click="btnLogout_Click" Background="Transparent" BorderThickness="0"
                                    Height="42" HorizontalAlignment="Stretch" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Logout" Width="16" Height="16" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="Đăng xuất" FontSize="13" Foreground="#D32F2F" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#15D32F2F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT SECTION -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FLOATING TOP BAR -->
                <Border Grid.Row="0" Margin="8,16,16,8" Padding="24,12" Background="#E8FFFFFF" CornerRadius="16"
                        MouseLeftButtonDown="Header_MouseDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bên trái: Ngày tháng -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CalendarBlank" Width="20" Height="20" Foreground="#546E7A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtDate" FontWeight="SemiBold" FontSize="14" Foreground="#263238" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Giữa: Tiêu đề hệ thống -->
                        <TextBlock Grid.Column="1" Text="HỆ THỐNG QUẢN LÝ HÀNG KHÔNG SKYBLUE" FontWeight="Bold" FontSize="13" Foreground="#3F51B5" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>

                        <!-- Bên phải: Avatar + Control Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <Border Width="1" Height="24" Background="#E0E0E0" Margin="0,0,16,0"/>
                            
                            <!-- User Profile -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" Cursor="Hand">
                                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3949AB" Offset="0"/>
                                            <GradientStop Color="#5C6BC0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock x:Name="txtAvatar" Text="NQ" FontSize="14" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#3949AB"/>
                                    </Border.Effect>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="txtHeaderUserName" Text="Nguyễn Quản Trị" FontSize="14" FontWeight="Bold" Foreground="#2D2D2D"/>
                                    <TextBlock x:Name="txtHeaderRole" Text="Administrator" FontSize="11" Foreground="#3F51B5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Window Controls (giống LUnivers Beaute) -->
                            <Border Width="1" Height="24" Background="#E0E0E0" Margin="8,0,16,0"/>
                            <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource WinControlBtn}" Content="─" FontSize="12" Click="btnMinimize_Click" Margin="2,0" ToolTip="Thu nhỏ"/>
                                <Button x:Name="btnMaxRestore" Style="{StaticResource WinControlBtn}" Content="□" FontSize="15" Click="btnMaximize_Click" Margin="2,0" ToolTip="Phóng to"/>
                                <Button Content="✕" FontSize="12" Click="btnClose_Click" Width="36" Height="36" ToolTip="Đóng &amp; Đăng xuất" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WinControlBtn}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#E53935"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTENT HOST -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,0,16,16">
                        <ContentControl x:Name="pageContent"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
