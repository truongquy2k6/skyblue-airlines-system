<Window x:Class="FlightManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SkyBlue Airlines - Đăng nhập" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    
    <!-- Border ngoài: chỉ chứa shadow, KHÔNG clip -->
    <Border CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.1" Color="#000000"/>
        </Border.Effect>
        <!-- Border trong: clip nội dung bo góc -->
        <Border CornerRadius="16" Background="White" ClipToBounds="True">
            <Border.Resources>
            <Style x:Key="DemoAccountStyle" TargetType="Border">
                <Setter Property="Background" Value="#15FFFFFF"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="15,10"/>
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#30FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#50FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Banner with Image -->
            <Border CornerRadius="0">
                <Border.Background>
                    <ImageBrush ImageSource="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&amp;w=2074&amp;auto=format&amp;fit=crop" 
                                Stretch="UniformToFill"/>
                </Border.Background>
                <Grid>
                    <!-- Dark overlay to make text pop -->
                    <Border Background="#AA0D47A1"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Image Source="/LogoFlightManagement.ico" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="SkyBlue Airlines" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hệ thống Quản lý Chuyến bay" FontSize="16" Foreground="#90CAF9" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Right Login Form -->
            <Grid Grid.Column="1" Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đăng nhập" FontSize="28" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nhập thông tin tài khoản của bạn" FontSize="13" Foreground="#78909C" Margin="0,0,0,35" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Email" FontSize="13" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" 
                             materialDesign:HintAssist.Hint="admin@skyblue.vn"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                             FontSize="14" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Mật khẩu" FontSize="13" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" 
                                 materialDesign:HintAssist.Hint="••••••••"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}" 
                                 FontSize="14" Margin="0,0,0,10" KeyDown="txtPassword_KeyDown"/>
                    
                    <TextBlock x:Name="txtError" Text="" Foreground="#E53935" FontSize="13" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    
                    <Grid Height="48" Margin="0,0,0,0">
                        <Button x:Name="btnLogin" Content="Đăng nhập" Background="#3F51B5" Foreground="White" BorderThickness="0" 
                                Height="48" FontSize="16" FontWeight="Bold" 
                                materialDesign:ButtonAssist.CornerRadius="10" Click="btnLogin_Click"/>
                        
                        <!-- Trạng thái chờ Loading -->
                        <StackPanel x:Name="loadingArea" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressBar x:Name="loadingSpinner" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                         Value="0" IsIndeterminate="True" 
                                         Width="24" Height="24" Foreground="#3F51B5" Margin="0,0,10,0"/>
                            <TextBlock x:Name="lblLoadingStatus" Text="Đang xác thực tài khoản..." FontSize="14" FontWeight="SemiBold" Foreground="#3F51B5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <Button Style="{StaticResource MaterialDesignIconButton}" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Foreground="#95A5A6" Width="30" Height="30" Margin="0,-20,-20,0" Click="btnExit_Click">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
    </Border>
</Window>
