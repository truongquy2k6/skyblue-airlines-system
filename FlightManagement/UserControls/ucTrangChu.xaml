<UserControl x:Class="FlightManagement.UserControls.ucTrangChu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="SoftCard" TargetType="Border">
            <Setter Property="Background" Value="#FDFDFD"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.04" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#3949AB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- Header: Tổng quan + Tạo đặt vé -->
        <Grid Margin="8,4,8,20">
            <StackPanel>
                <TextBlock Text="Tổng quan" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtRoleDate" FontSize="13" Foreground="#E8EAF6" Margin="0,4,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnQuickAction_Click" Tag="TimKiem"
                    Background="#3949AB" Foreground="White" BorderThickness="0" Height="40" Padding="20,0" Cursor="Hand"
                    materialDesign:ButtonAssist.CornerRadius="10">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Setter Property="Background" Value="#3949AB"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Tạo vé mới" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stat Cards: 4 cột -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="4,0,4,24">
            <Border Style="{StaticResource SoftCard}" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="CHUYẾN BAY HÔM NAY" Foreground="#4A5568" FontSize="10.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="txtChuyenBay" Text="0" FontSize="34" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="txtChuyenBayDelta" Text="" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftCard}" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="HÀNH KHÁCH" Foreground="#4A5568" FontSize="10.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="txtTongVe" Text="0" FontSize="34" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock x:Name="txtVeDelta" Text="" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftCard}" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="ĐÚNG GIỜ" Foreground="#4A5568" FontSize="10.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="txtDoiBay" Text="0" FontSize="34" FontWeight="Bold" Foreground="#3949AB"/>
                        <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="#3949AB" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SoftCard}" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="DOANH THU HÔM NAY" Foreground="#4A5568" FontSize="10.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="đ" FontSize="20" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Bottom" Margin="0,0,2,6"/>
                        <TextBlock x:Name="txtDoanhThu" Text="0" FontSize="34" FontWeight="Bold" Foreground="#E65100"/>
                        <TextBlock x:Name="txtDoanhThuDelta" Text="" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Middle section: Bản đồ + Lịch bay -->
        <Grid Grid.Row="2" Margin="4,12,4,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.45*"/>
                <ColumnDefinition Width="0.55*"/>
            </Grid.ColumnDefinitions>

            <!-- Bản đồ tuyến bay (tĩnh) -->
            <Border Style="{StaticResource SoftCard}" Padding="16" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Bản đồ tuyến bay" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                        <Border HorizontalAlignment="Right" CornerRadius="6" Padding="10,4" Background="#F0F2F5">
                            <TextBlock Text="Trực tiếp" FontSize="11" Foreground="#FF0000" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,5,0,0" HorizontalAlignment="Center" MaxHeight="280">
                        <Grid Width="350" Height="250">
                            <!-- Nền mô phỏng hình oval tĩnh -->
                            <Ellipse Width="340" Height="240" Fill="#F0F4FF" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <!-- Canvas động cho các điểm sân bay và đường bay -->
                            <Canvas x:Name="canvasMap" Width="350" Height="250" ClipToBounds="False"/>
                            
                            <!-- Legend -->
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="#3949AB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đang hoạt động" FontSize="10" Foreground="#546E7A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#E65100" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tần suất cao" FontSize="10" Foreground="#546E7A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Lịch bay hôm nay -->
            <Border Grid.Column="1" Style="{StaticResource SoftCard}" Padding="16" Margin="8,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="txtLichBayTitle" Text="Lịch bay hôm nay" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Xem tất cả →" HorizontalAlignment="Right" FontSize="12" Foreground="#3949AB" 
                                   FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="btnXemTatCaLichBay_Click"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="dgLichBay" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionUnit="CellOrRowHeader" ClipToBounds="True" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              HeadersVisibility="Column" CanUserAddRows="False" BorderThickness="0"
                              GridLinesVisibility="Horizontal" Background="Transparent"
                              HorizontalGridLinesBrush="#F0F0F0" RowHeight="38"
                              RowBackground="Transparent" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ" Binding="{Binding SoHieu}" Width="0.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#3949AB"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CHẶNG" Binding="{Binding TuyenBay}" Width="*"/>
                            <DataGridTextColumn Header="GIỜ" Binding="{Binding GioBay}" Width="0.5*"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding TrangThai}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" x:Name="txtNoFlights" Text="⚠ Không có chuyến bay nào hôm nay" 
                               Foreground="#90A4AE" HorizontalAlignment="Center" Margin="0,30,0,30"
                               FontSize="14" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom section: Đặt vé gần đây + Thao tác nhanh -->
        <Grid Grid.Row="3" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Đặt vé gần đây -->
            <Border Style="{StaticResource SoftCard}" Padding="16" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Đặt vé gần đây" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Xem tất cả →" HorizontalAlignment="Right" FontSize="12" Foreground="#3949AB" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonDown="btnXemTatCaDatVe_Click"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="dgDatVeGanDay" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionUnit="CellOrRowHeader" ClipToBounds="True" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              HeadersVisibility="Column" CanUserAddRows="False" BorderThickness="0"
                              GridLinesVisibility="Horizontal" Background="Transparent" HorizontalGridLinesBrush="#F0F0F0" RowHeight="38"
                              RowBackground="Transparent" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đặt chỗ" Binding="{Binding MaDatCho}" Width="0.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#3949AB"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding TenKhach}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ngày đặt" Binding="{Binding NgayGio, StringFormat=dd/MM/yyyy}" Width="0.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#546E7A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Thao tác nhanh -->
            <Border Grid.Column="1" Style="{StaticResource SoftCard}" Padding="16" Margin="8,0,4,0">
                <StackPanel>
                    <TextBlock Text="Thao tác nhanh" FontSize="15" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Rows="5">
                        <Button Margin="0,0,6,6" Height="38" Click="btnQuickAction_Click" Tag="TimKiem" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AirplaneSearch" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Tìm kiếm Chuyến bay" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,6" Height="38" Click="btnQuickAction_Click" Tag="QuanLyVe" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TicketOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Vé &amp; Đặt chỗ" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,6" Height="38" Click="btnQuickAction_Click" Tag="DichVu" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RoomServiceOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Quản lý Dịch vụ" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,6" Height="38" Click="btnQuickAction_Click" Tag="CSKH" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Headset" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Chăm sóc Khách hàng" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,6" Height="38" Click="btnQuickAction_Click" Tag="LichBay" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Quản lý Lịch bay" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,6" Height="38" Click="btnQuickAction_Click" Tag="TuyenBay" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerPath" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Tuyến bay &amp; Đội bay" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,6" Height="38" Click="btnQuickAction_Click" Tag="HangGhe" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SeatOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cấu hình Hạng ghế" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,6" Height="38" Click="btnQuickAction_Click" Tag="NhanVien" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Quản lý Nhân viên" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,6" Height="38" Click="btnQuickAction_Click" Tag="BaoCao" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Báo cáo &amp; Thống kê" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,6" Height="38" Click="btnQuickAction_Click" Tag="LichSu" Style="{StaticResource QuickActionBtn}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Lịch sử Hệ thống" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
