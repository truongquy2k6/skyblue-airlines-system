<Window x:Class="FlightManagement.UserControls.SeatSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chọn Ghế Ngồi - VASTWING" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    
    <Window.Resources>
        <Style x:Key="SeatButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Foreground" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Border CornerRadius="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Background="#0D2A5C" CornerRadius="20,20,0,0" Padding="20,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AirplaneTakeoff" Foreground="White" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="SKYBLUE AIRLINE" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="btnClose" Click="btnHuy_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="0" MinWidth="30" HorizontalAlignment="Right">
                        <materialDesign:PackIcon Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/> <!-- Seat Map -->
                    <ColumnDefinition Width="1*"/> <!-- Sidebar -->
                </Grid.ColumnDefinitions>

                <!-- Left Column: Seats Selection -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="40,20">
                        <Button HorizontalAlignment="Left" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" Margin="0,0,0,20" Click="btnHuy_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,5,0"/>
                                <TextBlock Text="Quay lại"/>
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,0,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Ghế ngồi" FontSize="32" FontWeight="Bold" Foreground="#0D2A5C" Grid.Row="0"/>
                            
                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Vui lòng chọn chỗ ngồi của bạn" FontSize="18" Foreground="#0D2A5C" Opacity="0.8" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                <!-- Stepper -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <StackPanel Margin="10,0">
                                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="#0D2A5C" Style="{StaticResource StepIconStyle}"/>
                                        <TextBlock Text="Tìm kiếm" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Width="20" Height="1" Fill="#0D2A5C" Margin="0,0,0,15"/>
                                    <StackPanel Margin="10,0">
                                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="#0D2A5C" Style="{StaticResource StepIconStyle}"/>
                                        <TextBlock Text="Hành khách" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Width="20" Height="1" Fill="#0D2A5C" Margin="0,0,0,15"/>
                                    <StackPanel Margin="10,0">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#0D2A5C">
                                            <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="Chọn ghế" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Width="20" Height="1" Fill="LightGray" Margin="0,0,0,15"/>
                                    <StackPanel Margin="10,0">
                                        <Border Width="24" Height="24" CornerRadius="12" BorderBrush="LightGray" BorderThickness="1">
                                            <TextBlock Text="4" Foreground="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="Thanh toán" FontSize="10" Foreground="LightGray" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Passenger Card -->
                        <Border Background="#F0F4FF" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Account" Foreground="#0D2A5C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtPassengerName" Text="Tên hành khách" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0D2A5C"/>
                                    <TextBlock x:Name="txtPassengerCount" Text=" (1 khách)" VerticalAlignment="Center" Foreground="#0D2A5C" Opacity="0.6"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="White" CornerRadius="15" Padding="10,2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MapMarker" Foreground="Green" Width="14" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="txtRoute" Text="SGN - HAN" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Các ghế tiêu chuẩn ở hàng 18-33 đã bao gồm trong giá vé cơ bản. Nếu bạn chọn ghế ở các hàng khác, bạn sẽ trả phần chênh lệch chi phí." 
                                   TextWrapping="Wrap" FontSize="12" Foreground="Gray" Margin="0,0,0,20"/>

                        <!-- Airplane Cabin Container -->
                        <Grid HorizontalAlignment="Center" Margin="0,20">
                            <Border Width="450" BorderBrush="#E0E0E0" BorderThickness="2,2,2,0" CornerRadius="200,200,0,0" Padding="0,100,0,0">
                                <StackPanel>
                                    <!-- Exit Signs -->
                                    <Grid Margin="20,0">
                                        <TextBlock Text="Lối thoát" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Lối thoát" Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Row Labels (A B C   D E F) -->
                                    <Grid Margin="50,20,50,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <UniformGrid Columns="3" Grid.Column="0">
                                            <TextBlock Text="A" HorizontalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Text="B" HorizontalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Text="C" HorizontalAlignment="Center" Foreground="Gray"/>
                                        </UniformGrid>
                                        <UniformGrid Columns="3" Grid.Column="2">
                                            <TextBlock Text="D" HorizontalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Text="E" HorizontalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Text="F" HorizontalAlignment="Center" Foreground="Gray"/>
                                        </UniformGrid>
                                    </Grid>

                                    <!-- First Class Section -->
                                    <StackPanel x:Name="sectionFirstClass" Visibility="Collapsed">
                                        <Border Background="#FFFDE7" CornerRadius="10" HorizontalAlignment="Center" Padding="10,2" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtPriceFirst" Text="Hạng Nhất" FontSize="10" FontWeight="Bold" Foreground="#FBC02D"/>
                                        </Border>
                                        <WrapPanel x:Name="wpFirstClass" HorizontalAlignment="Center" Width="380"/>
                                    </StackPanel>

                                    <!-- Business Class Section -->
                                    <StackPanel x:Name="sectionBusiness" Margin="0,10">
                                        <Border Background="#E3F2FD" CornerRadius="10" HorizontalAlignment="Center" Padding="10,2" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtPriceBusiness" Text="Hạng Thương Gia" FontSize="10" FontWeight="Bold" Foreground="#1976D2"/>
                                        </Border>
                                        <WrapPanel x:Name="wpBusiness" HorizontalAlignment="Center" Width="380"/>
                                    </StackPanel>

                                    <!-- Economy Class Section -->
                                    <StackPanel x:Name="sectionEconomy" Margin="0,10">
                                        <Border Background="#F5F5F5" CornerRadius="10" HorizontalAlignment="Center" Padding="10,2" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtPriceEconomy" Text="Hạng Phổ Thông" FontSize="10" FontWeight="Bold" Foreground="Gray"/>
                                        </Border>
                                        <WrapPanel x:Name="wpEconomy" HorizontalAlignment="Center" Width="380"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right Column: Sidebar -->
                <Border Grid.Column="1" Background="#F8F9FB" Padding="30" CornerRadius="0,0,20,0">
                    <StackPanel>
                        <Button Content="Xác nhận" Height="50" FontSize="16" FontWeight="Bold" 
                                materialDesign:ButtonAssist.CornerRadius="25"
                                Background="#0052CC" BorderBrush="#0052CC" Foreground="White"
                                Margin="0,0,0,40" Click="btnXacNhan_Click"/>

                        <TextBlock Text="Loại ghế" FontSize="18" FontWeight="Bold" Foreground="#0D2A5C" Margin="0,0,0,20"/>

                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFD700" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Hạng Nhất" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#E53935" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Hạng Thương gia" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#1976D2" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Hạng Phổ thông" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#EEEEEE" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Ghế đã được đặt" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#0D2A5C" CornerRadius="8" Width="30" Height="30" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="Check" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Ghế bạn đang chọn" VerticalAlignment="Center" Foreground="Gray"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </materialDesign:DialogHost>
</Window>
