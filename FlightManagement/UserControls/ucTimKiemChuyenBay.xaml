<UserControl x:Class="FlightManagement.UserControls.ucTimKiemChuyenBay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="DefaultColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>
    
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/> <!-- Lọc tìm kiếm -->
            <RowDefinition Height="*"/>    <!-- Bảng kết quả (Cuộn mượt) -->
            <RowDefinition Height="Auto"/> <!-- Phân trang dưới đáy -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tìm kiếm Chuyến bay" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
        
        <!-- Filter - evenly distributed with Grid -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#3F51B5" BorderThickness="1.5">
            <GroupBox Header="Lọc chuyến bay" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Sân bay đi" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboSanBayDi" DisplayMemberPath="Display" SelectedValuePath="ID"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,12,0">
                        <TextBlock Text="Sân bay đến" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboSanBayDen" DisplayMemberPath="Display" SelectedValuePath="ID"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,12,0">
                        <TextBlock Text="Từ ngày" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpNgayTu"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="6,0,12,0">
                        <TextBlock Text="Đến ngày" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpNgayDen"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="🔍  Lọc" Click="btnLoc_Click" Background="#3F51B5" Foreground="White" 
                            Height="40" Padding="25,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,8,0"
                            materialDesign:ButtonAssist.CornerRadius="6"/>
                    <Button Grid.Column="5" Content="Đặt lại" Click="btnReset_Click" Background="#263238" Foreground="White" 
                            Height="40" Padding="20,0" FontSize="14" VerticalAlignment="Bottom"
                            materialDesign:ButtonAssist.CornerRadius="6"/>
                </Grid>
            </GroupBox>
        </Border>
        
        <!-- Results grouped by date wrapped in ScrollViewer to enable docking pagination at the bottom -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel x:Name="pnlResults"/>
        </ScrollViewer>
        
        <!-- Pagination docked at bottom -->
        <StackPanel x:Name="pnlPagination" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5" Visibility="Collapsed">
            <Button x:Name="btnPrevPage" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevPage_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
            <TextBlock x:Name="txtPageInfo" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14" Foreground="White"/>
            <Button x:Name="btnNextPage" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextPage_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
        </StackPanel>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>
