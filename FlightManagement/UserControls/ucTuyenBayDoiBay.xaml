<UserControl x:Class="FlightManagement.UserControls.ucTuyenBayDoiBay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="DefaultColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>

    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- TabControl (Fills all remaining height) -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tuyến bay &amp; Đội bay" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
        
        <TabControl Grid.Row="1" x:Name="tabControl" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <!-- Tab Sân bay -->
            <TabItem Foreground="White">
                <TabItem.Header>
                    <TextBlock Text="Quản lý Sân bay" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </TabItem.Header>
                <Grid Margin="10" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Stats -->
                        <RowDefinition Height="Auto"/> <!-- Header / Add Button -->
                        <RowDefinition Height="Auto"/> <!-- Inline form -->
                        <RowDefinition Height="*"/>    <!-- DataGrid (Fills tab space) -->
                        <RowDefinition Height="Auto"/> <!-- Pagination (Docked Bottom) -->
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tổng sân bay" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtSBTong" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Quốc nội (Việt Nam)" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtSBNMD" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Quốc tế" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtSBQT" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E65100"/></StackPanel></Border>
                    </UniformGrid>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="txtSBCount" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                        <Button Content="+ Thêm sân bay" HorizontalAlignment="Right" Background="#4CAF50" Foreground="White" Click="btnThemSB_Click"
                                materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="18,0" FontSize="14"/>
                    </Grid>
                    
                    <!-- Inline form -->
                    <Border Grid.Row="2" x:Name="pnlFormSB" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#3F51B5" BorderThickness="2" Visibility="Collapsed" TextElement.Foreground="Black">
                        <StackPanel>
                            <TextBlock x:Name="txtFormTitleSB" Text="Thêm sân bay" FontWeight="Bold" FontSize="15" Foreground="#3F51B5" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Mã IATA *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/><TextBox x:Name="txtIATA" MaxLength="3"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,10,0"><TextBlock Text="Tên sân bay *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/><TextBox x:Name="txtTenSB"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="5,0,0,0"><TextBlock Text="Quốc gia *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cboQuocGiaSB" DisplayMemberPath="TenQuocGia" SelectedValuePath="ID"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="💾 Lưu" Background="#4CAF50" Foreground="White" Click="btnLuuSB_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="20,0" Margin="0,0,8,0" FontSize="14"/>
                                <Button Content="Hủy" Click="btnHuySB_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="20,0" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- DataGrid stretched Container (VerticalAlignment="Top") -->
                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10" VerticalAlignment="Top">
                        <DataGrid x:Name="dgSanBay" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                                  ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                  CellStyle="{StaticResource DefaultCellStyle}"
                                  AlternatingRowBackground="#F4F6F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="70" MinWidth="70" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Mã IATA" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IATACode}" FontWeight="Bold" Foreground="#1565C0"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tên sân bay" Binding="{Binding TenSanBay}" Width="*" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Quốc gia" Binding="{Binding QuocGia}" Width="*" MinWidth="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnSuaSB_Click" Foreground="#1565C0" ToolTip="Sửa"><materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/></Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnXoaSB_Click" Foreground="Red" ToolTip="Xóa"><materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/></Button>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Pagination (Docked bottom) -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                        <Button x:Name="btnPrevSB" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevSB_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtPageInfoSB" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <Button x:Name="btnNextSB" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextSB_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- Tab Tuyến bay -->
            <TabItem Foreground="White">
                <TabItem.Header>
                    <TextBlock Text="Quản lý Tuyến bay" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </TabItem.Header>
                <Grid Margin="10" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Stats -->
                        <RowDefinition Height="Auto"/> <!-- Header / Add Button -->
                        <RowDefinition Height="Auto"/> <!-- Inline form -->
                        <RowDefinition Height="*"/>    <!-- DataGrid (Fills tab space) -->
                        <RowDefinition Height="Auto"/> <!-- Pagination (Docked Bottom) -->
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tổng tuyến bay" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtTBTong" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Khoảng cách dài nhất" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtTBMaxDist" Text="0 km" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Thời gian bay TB" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtTBAvgTime" Text="0 phút" FontSize="22" FontWeight="Bold" Foreground="#E65100"/></StackPanel></Border>
                    </UniformGrid>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="txtTBCount" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                        <Button Content="+ Thêm tuyến bay" HorizontalAlignment="Right" Background="#4CAF50" Foreground="White" Click="btnThemTB_Click"
                                materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="18,0" FontSize="14"/>
                    </Grid>
                    
                    <Border Grid.Row="2" x:Name="pnlFormTB" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#3F51B5" BorderThickness="2" Visibility="Collapsed" TextElement.Foreground="Black">
                        <StackPanel>
                            <TextBlock x:Name="txtFormTitleTB" Text="Thêm tuyến bay" FontWeight="Bold" FontSize="15" Foreground="#3F51B5" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Điểm đi *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cboSBDi" DisplayMemberPath="Display" SelectedValuePath="ID"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,8,0"><TextBlock Text="Điểm đến *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cboSBDen" DisplayMemberPath="Display" SelectedValuePath="ID"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,8,0"><TextBlock Text="Khoảng cách (km)" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtKhoangCach"/></StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBlock Text="Thời gian bay (phút)" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtThoiGian"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="💾 Lưu" Background="#4CAF50" Foreground="White" Click="btnLuuTB_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="20,0" Margin="0,0,8,0" FontSize="14"/>
                                <Button Content="Hủy" Click="btnHuyTB_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="20,0" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- DataGrid stretched Container (VerticalAlignment="Top") -->
                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10" VerticalAlignment="Top">
                        <DataGrid x:Name="dgTuyenBay" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                                  ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                  CellStyle="{StaticResource DefaultCellStyle}"
                                  AlternatingRowBackground="#F4F6F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="70" MinWidth="70" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Điểm đi" Binding="{Binding DiemDi}" Width="*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Điểm đến" Binding="{Binding DiemDen}" Width="*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Khoảng cách" Binding="{Binding KhoangCach, StringFormat={}{0:N0} km}" Width="145" MinWidth="145" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Thời gian bay" Binding="{Binding ThoiGianBay}" Width="135" MinWidth="135" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnSuaTB_Click" Foreground="#1565C0" ToolTip="Sửa"><materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/></Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnXoaTB_Click" Foreground="Red" ToolTip="Xóa"><materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/></Button>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Pagination (Docked bottom) -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                        <Button x:Name="btnPrevTB" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevTB_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtPageInfoTB" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <Button x:Name="btnNextTB" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextTB_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- Tab Đội bay (Máy bay) -->
            <TabItem Foreground="White">
                <TabItem.Header>
                    <TextBlock Text="Quản lý Đội bay" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </TabItem.Header>
                <Grid Margin="10" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Stats -->
                        <RowDefinition Height="Auto"/> <!-- Header / Add Button -->
                        <RowDefinition Height="Auto"/> <!-- Inline form -->
                        <RowDefinition Height="*"/>    <!-- DataGrid (Fills tab space) -->
                        <RowDefinition Height="Auto"/> <!-- Pagination (Docked Bottom) -->
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tổng máy bay" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtTong" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tàu bay thân hẹp (&lt;200 ghế)" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtNarrowBody" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tàu bay thân rộng (&gt;=200 ghế)" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtWideBody" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E65100"/></StackPanel></Border>
                    </UniformGrid>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock x:Name="txtTitle" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                        <Button Content="+ Thêm máy bay" HorizontalAlignment="Right" Background="#4CAF50" Foreground="White" Click="btnThem_Click"
                                materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="18,0" FontSize="14"/>
                    </Grid>
                    
                    <!-- Inline form -->
                    <Border Grid.Row="2" x:Name="pnlForm" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#3F51B5" BorderThickness="2" Visibility="Collapsed" TextElement.Foreground="Black">
                        <StackPanel>
                            <TextBlock x:Name="txtFormTitle" Text="Thêm máy bay mới" FontWeight="Bold" FontSize="15" Foreground="#3F51B5" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Tên máy bay *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtTenMB" materialDesign:HintAssist.Hint="VD: VN-A001"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,8,0"><TextBlock Text="Model *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtModel" materialDesign:HintAssist.Hint="VD: Boeing 787-9"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,8,0"><TextBlock Text="Tổng ghế *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtTongGheForm"/></StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,8,0"><TextBlock Text="Ghế Economy *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtEcoForm"/></StackPanel>
                                <StackPanel Grid.Column="4" Margin="4,0,8,0"><TextBlock Text="Ghế Business *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtBizForm"/></StackPanel>
                                <StackPanel Grid.Column="5" Margin="4,0,0,0"><TextBlock Text="Ghế First Class" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtFirstClassForm"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="💾 Lưu" Background="#4CAF50" Foreground="White" Click="btnLuu_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="20,0" Margin="0,0,8,0" FontSize="14"/>
                                <Button Content="Hủy" Click="btnHuy_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="20,0" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- DataGrid stretched Container (VerticalAlignment="Top") -->
                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10" VerticalAlignment="Top">
                        <DataGrid x:Name="dgMayBay" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                                  ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                  CellStyle="{StaticResource DefaultCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="70" MinWidth="70" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Tên máy bay" Width="130" MinWidth="130" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TenMayBay}" FontWeight="Bold" Foreground="#1565C0"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tổng ghế" Binding="{Binding TongGhe}" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Economy" Binding="{Binding GheEconomy}" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Business" Binding="{Binding GheBusiness}" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="First Class" Binding="{Binding GheFirstClass}" Width="110" MinWidth="110" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#B7950B"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnSua_Click" Foreground="#1565C0" ToolTip="Sửa"><materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/></Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnXoa_Click" Foreground="Red" ToolTip="Xóa"><materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/></Button>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Pagination (Docked bottom) -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                        <Button x:Name="btnPrevMB" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevMB_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtPageInfoMB" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <Button x:Name="btnNextMB" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextMB_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>
