<UserControl x:Class="FlightManagement.UserControls.ucDatVeMayBay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Grid>
        <!-- Placeholder when no flight selected -->
        <Border x:Name="pnlNoFlight" Background="White" CornerRadius="8" Padding="40" BorderBrush="#E0E0E0" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <Border Background="#FFC107" CornerRadius="10" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🎫" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Chưa chọn chuyến bay" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Bạn cần phải chọn một chuyến bay từ màn hình Tìm kiếm trước khi đặt vé."
                           FontSize="14" Foreground="#78909C" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" Margin="0,0,0,20"/>
                <Button x:Name="btnQuayLai" Content="Quay lại Tìm kiếm" Click="btnQuayLaiTimKiem_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="42" Padding="25,0" FontSize="15"
                        materialDesign:ButtonAssist.CornerRadius="6"/>
            </StackPanel>
        </Border>

        <!-- Booking form (hidden when no flight selected) -->
        <StackPanel x:Name="pnlBookingForm" Visibility="Visible">
            <TextBlock Text="Đặt vé Máy bay" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
            <!-- Flight Info -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <GroupBox Header="Thông tin chuyến bay" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <UniformGrid Columns="4" Grid.Column="0">
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Số hiệu" FontSize="12" Foreground="#78909C"/>
                            <TextBlock x:Name="txtSoHieu" Text="-" FontSize="16" FontWeight="Bold"/></StackPanel>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Tuyến bay" FontSize="12" Foreground="#78909C"/>
                            <TextBlock x:Name="txtTuyenBay" Text="-" FontSize="16" FontWeight="Bold"/></StackPanel>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Ngày bay" FontSize="12" Foreground="#78909C"/>
                            <TextBlock x:Name="txtNgayBay" Text="-" FontSize="16" FontWeight="Bold"/></StackPanel>
                            <StackPanel><TextBlock Text="Giờ bay" FontSize="12" Foreground="#78909C"/>
                            <TextBlock x:Name="txtGioBay" Text="-" FontSize="16" FontWeight="Bold"/></StackPanel>
                        </UniformGrid>
                        
                        <Button Grid.Column="1" x:Name="btnDoiChuyen" Content="Đổi chuyến bay" VerticalAlignment="Center" Margin="10,0,0,0"
                                Click="btnDoiChuyen_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Padding="15,0"
                                materialDesign:ButtonAssist.CornerRadius="6" BorderBrush="#FF9800" Foreground="#FF9800"/>
                    </Grid>
                </GroupBox>
            </Border>
            <!-- Passenger Info -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <GroupBox Header="Thông tin hành khách" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,10"><TextBlock Text="Họ *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHo" FontSize="14"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Tên *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTen" FontSize="14"/></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,10"><TextBlock Text="Email *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmailKhach" FontSize="14"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Số điện thoại *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSDT" FontSize="14"/></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,10,0"><TextBlock Text="Số hộ chiếu *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtHoChieu" FontSize="14"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Quốc tịch *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboQuocTich" DisplayMemberPath="TenQuocGia" SelectedValuePath="ID" FontSize="14"/></StackPanel>
                    </Grid>
                </GroupBox>
            </Border>
            <!-- Cabin Class & Seat -->
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Chọn hạng ghế" Padding="10" Margin="0,0,10,0">
                        <UniformGrid Columns="3" x:Name="pnlHangGhe"/>
                    </GroupBox>
                    <StackPanel Grid.Column="1">
                        <GroupBox Header="Ghế ngồi" Padding="10" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtGheDaChon" Text="Chưa chọn" FontSize="18" FontWeight="Bold" Foreground="#3F51B5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Button Content="Chọn ghế" Click="btnChonGhe_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="35"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Dịch vụ theo hạng ghế" Padding="10">
                            <StackPanel>
                                <TextBlock x:Name="txtNoAmenities" Text="Chưa có dịch vụ nào cho hạng ghế này."
                                           Foreground="#78909C" FontStyle="Italic" Margin="0,0,0,6" Visibility="Collapsed"/>
                                <WrapPanel x:Name="pnlTienIchHangGhe"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Total & Book -->
            <Border Background="#263238" CornerRadius="8" Padding="20">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tổng tiền: " Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTongTien" Text="0 đ" Foreground="#FFCA28" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Xác nhận đặt vé" HorizontalAlignment="Right" Background="#4CAF50" Foreground="White"
                            Height="42" Padding="25,0" FontSize="15" FontWeight="Bold" Click="btnDatVe_Click"
                            materialDesign:ButtonAssist.CornerRadius="8"/>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </materialDesign:DialogHost>
    </UserControl>
