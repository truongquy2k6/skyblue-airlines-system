<UserControl x:Class="FlightManagement.UserControls.ucQuanLyLichBay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="DefaultColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="txtTitle" Text="Quản lý Lịch bay" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnToggleStats" Content="📊 Ẩn thống kê" Click="btnToggleStats_Click" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Background="AliceBlue" Foreground="#1565C0" BorderBrush="#1565C0"
                        materialDesign:ButtonAssist.CornerRadius="6" Height="36" Margin="0,0,8,0"/>
                <Button Content="📥 Xuất Excel" Click="btnExportCSV_Click" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Background="AliceBlue" Foreground="#1565C0" BorderBrush="#1565C0"
                        materialDesign:ButtonAssist.CornerRadius="6" Height="36" Margin="0,0,8,0"/>
                <Button Content="+ Thêm lịch bay" Background="#4CAF50" Foreground="White" Click="btnThem_Click"
                        materialDesign:ButtonAssist.CornerRadius="6" Height="36" Padding="15,0"/>
            </StackPanel>
        </Grid>
        
        <StackPanel Grid.Row="1" x:Name="pnlStats">
            <UniformGrid Columns="5" Margin="0,0,0,15">
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Tổng chuyến bay" Foreground="#78909C" FontSize="11"/>
                    <TextBlock x:Name="txtTong" Text="0" FontSize="24" FontWeight="Bold" Foreground="#1565C0"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Đã xác nhận" Foreground="#78909C" FontSize="11"/>
                    <TextBlock x:Name="txtXacNhan" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Đã hủy" Foreground="#78909C" FontSize="11"/>
                    <TextBlock x:Name="txtHuy" Text="0" FontSize="24" FontWeight="Bold" Foreground="#C62828"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Sắp khởi hành" Foreground="#78909C" FontSize="11"/>
                    <TextBlock x:Name="txtSapKH" Text="0" FontSize="24" FontWeight="Bold" Foreground="#6A1B9A"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Giá TB" Foreground="#78909C" FontSize="11"/>
                    <TextBlock x:Name="txtGiaTB" Text="0" FontSize="24" FontWeight="Bold" Foreground="#E65100"/></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Top tuyến bay" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="lstTopRoutes"/></StackPanel></Border>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="8,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Máy bay sử dụng" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="lstAircraftUsage"/></StackPanel></Border>
            </Grid>
        </StackPanel>
        
        <!-- Filters - Grid based, evenly distributed -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tìm kiếm &amp; Bộ lọc" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Tìm kiếm" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSearch" materialDesign:HintAssist.Hint="Số hiệu, tuyến..." TextChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock Text="Tuyến bay" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboTuyen" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,8,0">
                        <TextBlock Text="Máy bay" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboMayBay" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,8,0">
                        <TextBlock Text="Trạng thái" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboTrangThai" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="4,0,8,0">
                        <TextBlock Text="Ngày bay" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpFilterNgay" SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="5" Content="✕ Xóa bộ lọc" VerticalAlignment="Bottom" Click="btnXoaBoLoc_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Inline Form -->
        <Border Grid.Row="3" x:Name="pnlForm" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#3F51B5" BorderThickness="2" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="txtFormTitle" Text="Thêm lịch bay mới" FontWeight="Bold" FontSize="16" Foreground="#3F51B5" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,8,10"><TextBlock Text="Số hiệu *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtSoHieu"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,8,10"><TextBlock Text="Tuyến bay *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboTuyenForm" DisplayMemberPath="Display" SelectedValuePath="ID"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,8,10"><TextBlock Text="Máy bay *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboMayBayForm" DisplayMemberPath="Display" SelectedValuePath="ID"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,0,10"><TextBlock Text="Giá Phổ Thông *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtGia"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="Ngày bay *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpNgayBay"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,8,10"><TextBlock Text="Giờ bay *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtGioBay" materialDesign:HintAssist.Hint="HH:mm"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,8,10"><TextBlock Text="Trạng thái" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboTrangThaiForm"><ComboBoxItem Content="Đã xác nhận" IsSelected="True"/><ComboBoxItem Content="Đã hủy"/></ComboBox></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="💾 Lưu" Background="#4CAF50" Foreground="White" Click="btnLuu_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="20,0" Margin="0,0,8,0" FontSize="14"/>
                        <Button Content="Hủy" Click="btnHuyForm_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="20,0" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <TextBlock Grid.Row="4" x:Name="txtCount" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="White"/>
        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" VerticalAlignment="Top">
            <DataGrid x:Name="dgLichBay" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                      ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                      CellStyle="{StaticResource DefaultCellStyle}"
                      AlternatingRowBackground="#F4F6F9">
                <DataGrid.Columns>
                    <!-- Badged Flight Number -->
                    <DataGridTemplateColumn Header="Số hiệu" Width="120" MinWidth="120" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SoHieu}" FontWeight="Bold" Foreground="#1565C0"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Left Aligned Route -->
                    <DataGridTextColumn Header="Tuyến bay" Binding="{Binding TuyenBay}" Width="1.5*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Centered Date -->
                    <DataGridTextColumn Header="Ngày bay" Binding="{Binding NgayBay, StringFormat=dd/MM/yyyy}" Width="110" MinWidth="110" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Centered Time -->
                    <DataGridTextColumn Header="Giờ bay" Binding="{Binding GioBay}" Width="90" MinWidth="90" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Centered Aircraft -->
                    <DataGridTextColumn Header="Máy bay" Binding="{Binding MayBay}" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Centered Free Seats -->
                    <DataGridTextColumn Header="Ghế trống" Binding="{Binding GheTrong}" Width="95" MinWidth="95" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Price Economy (Phổ Thông) -->
                    <DataGridTextColumn Header="Giá Phổ Thông" Binding="{Binding GiaEconomy, StringFormat={}{0:N0} đ}" Width="1.2*" MinWidth="125" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#E65100"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Price Business (Thương Gia) -->
                    <DataGridTextColumn Header="Giá Thương Gia" Binding="{Binding GiaBusiness, StringFormat={}{0:N0} đ}" Width="1.2*" MinWidth="125" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#6A1B9A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Price First Class (Hạng Nhất) -->
                    <DataGridTextColumn Header="Giá Hạng Nhất" Binding="{Binding GiaFirstClass, StringFormat={}{0:N0} đ}" Width="1.2*" MinWidth="125" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#B7950B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Pill Badge Status -->
                    <DataGridTemplateColumn Header="Trạng thái" Width="120" MinWidth="120" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="statusBorder" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="statusText" Text="{Binding TrangThai}" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã xác nhận">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#E8F5E9"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã hủy">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#FFEBEE"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Thao tác" Width="95" MinWidth="95" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnSua_Click" Foreground="#1565C0" ToolTip="Sửa">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/></Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnXoa_Click" Foreground="Red" ToolTip="Xóa">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/></Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination outside of the white card -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
            <Button x:Name="btnPrev" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrev_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
            <TextBlock x:Name="txtPageInfo" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14" Foreground="White"/>
            <Button x:Name="btnNext" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNext_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
        </StackPanel>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>
