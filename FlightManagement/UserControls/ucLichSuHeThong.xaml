<UserControl x:Class="FlightManagement.UserControls.ucLichSuHeThong"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- Custom TabItem Header Style with bulletproof White text triggers -->
        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock x:Name="tabText" Text="{Binding}" Foreground="#E3F2FD" FontSize="14.5" FontWeight="SemiBold" Margin="4,2"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                <Setter TargetName="tabText" Property="Foreground" Value="White"/>
                                <Setter TargetName="tabText" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                <Setter TargetName="tabText" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 100% Custom Column Header Style (Overriding MaterialDesign entirely to prevent black hover/sort text) -->
        <Style x:Key="DefaultColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <!-- Elegant White Sort Indicator -->
                            <Path x:Name="SortArrow" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                  Width="8" Height="6" Margin="0,0,12,0" Fill="White" Stretch="Fill" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Centered Header Style -->
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cell Style -->
        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>
    
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Lịch sử Hệ thống" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Access History Tab -->
            <TabItem Header="Lịch sử truy cập">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="txtTruyCapCount" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                        <Button Content="🗑 Xóa tất cả" Background="#E53935" BorderBrush="#E53935" Foreground="White" HorizontalAlignment="Right"
                                Click="btnXoaTruyCap_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="36" Padding="16,0" FontWeight="Bold"/>
                    </Grid>
                    
                    <!-- VerticalAlignment="Top" eliminates empty white space in short lists -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" VerticalAlignment="Top">
                        <DataGrid x:Name="dgTruyCap" AutoGenerateColumns="False" IsReadOnly="False" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                                  ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                  CellStyle="{StaticResource DefaultCellStyle}"
                                  AlternatingRowBackground="#F4F6F9">
                            <DataGrid.Columns>
                                <!-- Login Time -->
                                <DataGridTextColumn Header="Thời gian đăng nhập" Binding="{Binding ThoiGianDangNhap, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Logout Time -->
                                <DataGridTextColumn Header="Thời gian đăng xuất" Binding="{Binding ThoiGianDangXuat, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- User Name -->
                                <DataGridTextColumn Header="Người dùng" Binding="{Binding HoTen}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Balanced Email -->
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Role -->
                                <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}" Width="1.2*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Badged IP -->
                                <DataGridTemplateColumn Header="IP" Width="1.1*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultCellStyle}">
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#ECEFF1" CornerRadius="6" Padding="0,6" Margin="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DiaChiIP}" FontWeight="Bold" Foreground="#37474F" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Badged Result -->
                                <DataGridTemplateColumn Header="Kết quả" Width="1.1*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultCellStyle}">
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="0,6" Margin="6,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding KetQua}" Value="Thất bại">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding KetQua}" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding KetQua}" Value="Thất bại">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Circular Pagination (Dock Bottom) outside of the white card border -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                        <Button x:Name="btnPrevTC" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevTC_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtPaginationInfoTC" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14.5" Foreground="White"/>
                        <Button x:Name="btnNextTC" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextTC_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Edit History Tab -->
            <TabItem Header="Lịch sử chỉnh sửa">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="txtChinhSuaCount" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
                        <Button Content="🗑 Xóa tất cả" Background="#E53935" BorderBrush="#E53935" Foreground="White" HorizontalAlignment="Right"
                                Click="btnXoaChinhSua_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="36" Padding="16,0" FontWeight="Bold"/>
                    </Grid>
                    
                    <!-- VerticalAlignment="Top" eliminates empty white space in short lists -->
                     <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" VerticalAlignment="Top">
                        <DataGrid x:Name="dgChinhSua" AutoGenerateColumns="False" IsReadOnly="False" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                                  ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                  CellStyle="{StaticResource DefaultCellStyle}"
                                  AlternatingRowBackground="#F4F6F9">
                            <DataGrid.Columns>
                                <!-- Time -->
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding ThoiGian, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- User -->
                                <DataGridTextColumn Header="Người dùng" Binding="{Binding NguoiDung}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Badged Action -->
                                <DataGridTemplateColumn Header="Hành động" Width="1.2*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultCellStyle}">
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8EAF6" CornerRadius="6" Padding="0,6" Margin="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding HanhDong}" FontWeight="Bold" Foreground="#3F51B5" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Badged Target -->
                                <DataGridTemplateColumn Header="Đối tượng" Width="1.3*" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultCellStyle}">
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E0F2F1" CornerRadius="6" Padding="0,6" Margin="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DoiTuong}" FontWeight="Bold" Foreground="#00796B" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Content -->
                                <DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDung}" Width="3.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Circular Pagination (Dock Bottom) outside of the white card border -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                        <Button x:Name="btnPrevCS" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevCS_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtPaginationInfoCS" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14.5" Foreground="White"/>
                        <Button x:Name="btnNextCS" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextCS_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>
