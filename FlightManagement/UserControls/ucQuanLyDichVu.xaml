<UserControl x:Class="FlightManagement.UserControls.ucQuanLyDichVu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="DefaultColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>
    
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Add Button -->
            <RowDefinition Height="*"/>    <!-- TabControl (Fills remaining height) -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Quản lý Dịch vụ" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
            <Button Content="+ Thêm dịch vụ" HorizontalAlignment="Right" Background="#4CAF50" Foreground="White" Click="btnThemDV_Click"
                    materialDesign:ButtonAssist.CornerRadius="6" Height="36" Padding="18,0" FontSize="14"/>
        </Grid>
        
        <TabControl Grid.Row="1" x:Name="tcDichVu" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <!-- Tab 1: Gán dịch vụ cho vé -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Gán dịch vụ cho vé" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </TabItem.Header>
                <StackPanel Margin="10">
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Chọn vé máy bay của hành khách" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="cboVe" IsEditable="True" IsTextSearchEnabled="False" FontSize="14" Padding="8,6" materialDesign:HintAssist.Hint="Chọn hoặc nhập mã đặt chỗ, tên khách..." SelectionChanged="cboVe_SelectionChanged"/>
                                <Button Grid.Column="1" Content="Làm mới" Click="btnLamMoiVe_Click" Background="#ECEFF1" Foreground="#37474F" BorderBrush="#B0BEC5" BorderThickness="1" Height="36" Padding="15,0" Margin="10,0,0,0" materialDesign:ButtonAssist.CornerRadius="6" FontSize="13.5" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="pnlDichVuVe" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="txtVeInfo" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                            <TextBlock Text="Dịch vụ đã gán:" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                             <DataGrid x:Name="dgDichVuVe" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                       GridLinesVisibility="Horizontal" BorderThickness="0" MaxHeight="450" ColumnHeaderHeight="38" RowHeight="40" FontSize="13.5"
                                       ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                       CellStyle="{StaticResource DefaultCellStyle}"
                                       AlternatingRowBackground="#F4F6F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dịch vụ" Binding="{Binding TenDichVu}" Width="*" MinWidth="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giá (đ)" Binding="{Binding Gia, StringFormat=N0}" Width="150" MinWidth="150" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Gỡ" Width="80" MinWidth="80" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Click="btnGoDichVuVe_Click" Foreground="Red" FontSize="13" Height="28" Width="28" Style="{StaticResource MaterialDesignIconButton}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                             </DataGrid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboDichVuGan" DisplayMemberPath="TenDichVu" SelectedValuePath="ID" FontSize="14"/>
                                <Button Grid.Column="1" Content="+ Gán dịch vụ" Click="btnGanDichVu_Click" Background="#4CAF50" Foreground="White" Height="38" Padding="15,0" Margin="12,0,0,0"
                                        materialDesign:ButtonAssist.CornerRadius="6" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            
            <!-- Tab 2: Quản lý dịch vụ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Quản lý dịch vụ" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </TabItem.Header>
                <Grid Margin="10" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Stats -->
                        <RowDefinition Height="Auto"/> <!-- Top 3 popular -->
                        <RowDefinition Height="Auto"/> <!-- Inline form -->
                        <RowDefinition Height="*"/>    <!-- DataGrid (Fills tab space) -->
                        <RowDefinition Height="Auto"/> <!-- Pagination (Docked Bottom) -->
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tổng dịch vụ" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtTong" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="3,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Giá trung bình" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtGiaTB" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></Border>
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel><TextBlock Text="Tổng doanh thu DV" Foreground="#78909C" FontSize="11"/>
                            <TextBlock x:Name="txtDoanhThu" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E65100"/></StackPanel></Border>
                    </UniformGrid>
                    
                    <!-- Top 3 -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel><TextBlock Text="🏆 Top 3 dịch vụ phổ biến" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="lstTop3"/></StackPanel>
                    </Border>
                    
                    <!-- Inline form -->
                    <Border Grid.Row="2" x:Name="pnlFormDV" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#3F51B5" BorderThickness="2" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="txtFormTitleDV" Text="Thêm dịch vụ mới" FontWeight="Bold" FontSize="15" Foreground="#3F51B5" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Tên dịch vụ *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/><TextBox x:Name="txtTenDV" FontSize="14"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Giá (đ) *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/><TextBox x:Name="txtGiaDV" FontSize="14"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="💾 Lưu" Background="#4CAF50" Foreground="White" Click="btnLuuDV_Click" materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="20,0" Margin="0,0,8,0" FontSize="14"/>
                                <Button Content="Hủy" Click="btnHuyDV_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="20,0" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid stretched Container (VerticalAlignment="Top") -->
                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10" VerticalAlignment="Top">
                        <DataGrid x:Name="dgDichVu" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" ColumnHeaderHeight="40" RowHeight="42" FontSize="13.5"
                                  ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                                  CellStyle="{StaticResource DefaultCellStyle}"
                                  AlternatingRowBackground="#F4F6F9">
                            <DataGrid.Columns>
                                <!-- Badged ID -->
                                <DataGridTemplateColumn Header="ID" Width="80" MinWidth="80" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ID}" FontWeight="Bold" Foreground="#1565C0"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Left Aligned Service Name -->
                                <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding TenDichVu}" Width="*" MinWidth="250">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Price -->
                                <DataGridTextColumn Header="Giá (đ)" Binding="{Binding Gia, StringFormat=N0}" Width="180" MinWidth="180" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Thao tác" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnSuaDV_Click" Foreground="#1565C0" ToolTip="Sửa">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/></Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnXoaDV_Click" Foreground="Red" ToolTip="Xóa">
                                                    <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/></Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Pagination (Docked bottom) -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                        <Button x:Name="btnPrevDV" Content="&lt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnPrevDV_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtPageInfoDV" Text="Trang 1/1" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        <Button x:Name="btnNextDV" Content="&gt;" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White" Width="36" Height="36" Click="btnNextDV_Click" Padding="0" materialDesign:ButtonAssist.CornerRadius="18"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>
