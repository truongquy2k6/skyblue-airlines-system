<UserControl x:Class="FlightManagement.UserControls.ucCauHinhHangGhe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,12">
            <TextBlock Text="Cấu hình Hạng ghế" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
            
            <!-- Description & Category Tab Card -->
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderThickness="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#E8EAF6" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Settings" Width="22" Height="22" Foreground="#3F51B5" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cấu hình Hạng ghế và Tiện ích" FontWeight="Bold" FontSize="17.5" Foreground="#1A237E"/>
                            <TextBlock Text="Thiết lập các dịch vụ tiện ích mặc định đi kèm cho từng phân khúc hạng vé" Foreground="#78909C" FontSize="12.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Separator Background="#ECEFF1" Margin="0,8,0,16"/>
                    
                    <TextBlock Text="Chọn phân khúc hạng ghế cần cấu hình:" FontSize="13.5" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,12"/>
                    <WrapPanel x:Name="pnlCabinButtons"/>
                </StackPanel>
            </Border>
            
            <!-- Amenity Grid Card -->
            <Border Background="White" CornerRadius="12" Padding="24" BorderThickness="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#E0F2F1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Gift" Width="22" Height="22" Foreground="#00796B" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtCabinTitle" Text="Tiện ích cho hạng Phổ Thông" FontWeight="Bold" FontSize="17.5" Foreground="#004D40"/>
                            <TextBlock Text="Bật/Tắt các tiện ích được miễn phí đi kèm cho hành khách đặt hạng vé này" Foreground="#78909C" FontSize="12.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Separator Background="#ECEFF1" Margin="0,8,0,20"/>
                    
                    <WrapPanel x:Name="pnlAmenities" Margin="0,0,0,15"/>
                    
                    <Button Click="btnSave_Click" HorizontalAlignment="Right" Background="#00796B" Foreground="White" Height="40" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="8" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="XÁC NHẬN LƯU CẤU HÌNH" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>
