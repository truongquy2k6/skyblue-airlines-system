<UserControl x:Class="FlightManagement.UserControls.ucQuanLyNhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="DefaultColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="Foreground" Value="#FFF176"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style x:Key="DefaultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>
    <materialDesign:DialogHost x:Name="dialogHost" CloseOnClickAway="False">
    <StackPanel>
        <!-- Header with title + buttons -->
        <Grid Margin="0,0,0,15">
            <TextBlock Text="Quản lý Nhân viên" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnToggleStats" Content="📊 Ẩn thống kê" Click="btnToggleStats_Click" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Background="AliceBlue" Foreground="#1565C0" BorderBrush="#1565C0"
                        materialDesign:ButtonAssist.CornerRadius="6" Height="36" Margin="0,0,8,0"/>
                <Button Content="📥 Xuất Excel" Click="btnExportCSV_Click" 
                        Style="{StaticResource MaterialDesignOutlinedButton}" Background="AliceBlue" Foreground="#1565C0" BorderBrush="#1565C0"
                        materialDesign:ButtonAssist.CornerRadius="6" Height="36" Margin="0,0,8,0"/>
                <Button Content="+ Thêm nhân viên" Background="#4CAF50" Foreground="White" Click="btnThem_Click"
                        materialDesign:ButtonAssist.CornerRadius="6" Height="36" Padding="15,0"/>
            </StackPanel>
        </Grid>

        <!-- Stats -->
        <StackPanel x:Name="pnlStats">
            <UniformGrid Columns="3" Margin="0,0,0,15">
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Tổng nhân viên" Foreground="#78909C" FontSize="12"/>
                    <TextBlock x:Name="txtTong" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1565C0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="4,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Đang hoạt động" Foreground="#78909C" FontSize="12"/>
                    <TextBlock x:Name="txtHoatDong" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="8,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel><TextBlock Text="Đã khóa" Foreground="#78909C" FontSize="12"/>
                    <TextBlock x:Name="txtKhoa" Text="0" FontSize="26" FontWeight="Bold" Foreground="#C62828"/></StackPanel>
                </Border>
            </UniformGrid>

            <!-- Distribution panels -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Phân bổ theo Vai trò" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="lstVaiTro"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="8,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Phân bổ theo Văn phòng" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="lstVanPhong"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Search & Filter - Grid layout for even distribution -->
        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tìm kiếm &amp; Bộ lọc" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Tìm kiếm" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSearch" materialDesign:HintAssist.Hint="Tên, email..." TextChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock Text="Vai trò" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboVaiTro" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,8,0">
                        <TextBlock Text="Văn phòng" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboVanPhong" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,8,0">
                        <TextBlock Text="Trạng thái" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboTrangThai" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="✕ Xóa bộ lọc" VerticalAlignment="Bottom" Click="btnXoaBoLoc_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Inline Add/Edit Form (hidden by default) -->
        <Border x:Name="pnlForm" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#3F51B5" BorderThickness="2" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="txtFormTitle" Text="Thêm nhân viên mới" FontWeight="Bold" FontSize="16" Foreground="#3F51B5" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,8,10"><TextBlock Text="Họ *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtHo"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,8,10"><TextBlock Text="Tên *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTen"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,8,10"><TextBlock Text="Email *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEmailForm"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0,0,10"><TextBlock Text="Mật khẩu *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtMatKhau"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="Văn phòng *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboVanPhongForm" DisplayMemberPath="TenVanPhong" SelectedValuePath="ID"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,8,10"><TextBlock Text="Vai trò *" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboVaiTroForm" DisplayMemberPath="TenVaiTro" SelectedValuePath="ID"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,8,10"><TextBlock Text="Ngày sinh" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpNgaySinh"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="💾 Lưu" Background="#4CAF50" Foreground="White" Click="btnLuu_Click"
                                materialDesign:ButtonAssist.CornerRadius="6" Height="38" Padding="20,0" Margin="0,0,8,0" FontSize="14"/>
                        <Button Content="Hủy" Click="btnHuyForm_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Padding="20,0" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <TextBlock x:Name="txtCount" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="White"/>
        <Border Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1" VerticalAlignment="Top">
            <DataGrid x:Name="dgNhanVien" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0"
                      SelectionMode="Single" ColumnHeaderHeight="42" RowHeight="46" FontSize="13.5"
                      AlternatingRowBackground="#F4F6F9"
                      ColumnHeaderStyle="{StaticResource DefaultColumnHeaderStyle}"
                      CellStyle="{StaticResource DefaultCellStyle}">
                <DataGrid.Columns>
                    <!-- ID Badge -->
                    <DataGridTemplateColumn Header="ID" Width="65" MinWidth="65" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ID}" Foreground="#1565C0" FontWeight="Bold" FontSize="12.5"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="1.8*" MinWidth="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Văn phòng" Binding="{Binding VanPhong}" Width="1.5*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}" Width="1.2*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh, StringFormat=d/M/yyyy}" Width="110" MinWidth="110" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Dynamic Status Pill Badges -->
                    <DataGridTemplateColumn Header="Trạng thái" Width="110" MinWidth="110" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="statusBorder" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="statusText" Text="{Binding TrangThai}" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Hoạt động">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#E8F5E9"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã khóa">
                                        <Setter TargetName="statusBorder" Property="Background" Value="#FFEBEE"/>
                                        <Setter TargetName="statusText" Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thao tác" Width="100" MinWidth="100" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnSua_Click" ToolTip="Sửa" Foreground="#1565C0">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Click="btnXoa_Click" ToolTip="Khóa" Foreground="#E53935">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
    </materialDesign:DialogHost>
</UserControl>
