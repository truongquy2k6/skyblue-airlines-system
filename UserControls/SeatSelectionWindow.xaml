<Window x:Class="FlightManagement.UserControls.SeatSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chọn Ghế Ngồi" Height="650" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Background="#3F51B5" Padding="15">
            <TextBlock Text="SƠ ĐỒ GHẾ NGỒI" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Border Width="20" Height="20" Background="#FFF8E1" BorderBrush="DarkOrange" BorderThickness="1"/>
                    <TextBlock Text="Business" Margin="5,0,15,0" VerticalAlignment="Center"/>
                    <Border Width="20" Height="20" Background="#E3F2FD" BorderBrush="DodgerBlue" BorderThickness="1"/>
                    <TextBlock Text="Economy" Margin="5,0,15,0" VerticalAlignment="Center"/>
                    <Border Width="20" Height="20" Background="LightGray" BorderBrush="Gray" BorderThickness="1"/>
                    <TextBlock Text="Đã đặt" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Business Class" FontWeight="Bold" FontSize="16" Foreground="#FFC107" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <WrapPanel x:Name="wpBusiness" HorizontalAlignment="Center" Width="260" Margin="0,0,0,20"/>
                
                <TextBlock Text="Economy Class" FontWeight="Bold" FontSize="16" Foreground="#2196F3" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <WrapPanel x:Name="wpEconomy" HorizontalAlignment="Center" Width="380"/>
            </StackPanel>
        </ScrollViewer>
        
        <Border Grid.Row="2" Background="#ECEFF1" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Xác nhận" Width="120" Margin="0,0,10,0" Click="btnXacNhan_Click"/>
                <Button Content="Hủy" Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" Click="btnHuy_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
